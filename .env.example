# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
#
# RULE (AGENTS.md #1): anything prefixed NEXT_PUBLIC_ is readable in the browser bundle.
# Nothing secret may ever carry that prefix.

# ---- Supabase ----
# URL and anon key are public by design — they ship in the client bundle and are
# protected by Row Level Security. Safe here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses all RLS — full read/write/delete on every table.
# Never import this into a client component. Never log it.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Gemini ----
# Two keys from TWO SEPARATE Google Cloud projects. Free-tier quota is enforced
# per project, not per key — two keys in one project buy zero extra quota.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# Model IDs live here, never hardcoded (AGENTS.md #5). Google renames these often.
GEMINI_MODEL_FREE=
GEMINI_MODEL_PRO=

# ---- Cron ----
# Shared secret the daily trend job presents to prove it is Vercel Cron, not a stranger.
CRON_SECRET=

# ---- BYOK ----
# Encrypts user-supplied Gemini keys at rest in user_api_keys.key_encrypted.
# If this is lost or changed, every stored BYOK key becomes undecryptable.
ENCRYPTION_KEY=
