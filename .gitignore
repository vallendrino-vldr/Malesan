# ---- secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
service-account*.json

# ---- dependencies ----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- next.js ----
.next/
out/
build/
dist/
next-env.d.ts

# ---- vercel ----
.vercel

# ---- supabase ----
.branches
.temp
supabase/.temp/

# ---- testing ----
coverage/
*.lcov

# ---- typescript ----
*.tsbuildinfo

# ---- logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# ---- editor / os ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# graphify: rebuilt from src/ by AST at zero LLM cost, so it is a build artifact
graphify-out/

# Working notes — process docs, not product. Kept local.
.notes/

# Agent tooling installed per-machine by `npx skills add`. These are the
# operator's toolbox, not the product — they are re-installable, they are large
# (a few hundred files), and committing them buries a real diff. `.claude/` is
# excluded except launch.json, which is project config and was already tracked.
.agents/
.hermes/
skills-lock.json
.claude/*
!.claude/launch.json
