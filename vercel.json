{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/briefing?type=morning",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/briefing?type=evening",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/trends",
      "schedule": "0 0 * * *"
    }
  ]
}
