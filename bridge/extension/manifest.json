{
  "manifest_version": 3,
  "name": "Malesan Bridge",
  "version": "2.1.3",
  "description": "Menghubungkan Auto Clip Malesan ke pemrosesan video lokal.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://malesan.my.id/*",
        "https://www.malesan.my.id/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://malesan.my.id/*",
      "https://www.malesan.my.id/*",
      "http://localhost:3000/*",
      "http://localhost:3001/*",
      "http://127.0.0.1:3000/*"
    ]
  }
}
